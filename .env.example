# Copy to .env and adjust. Never commit real values.
# The platform server reads the process environment; see setup.md.

# development | production
PP_ENV=development

# Address the API binds to
PP_API_HOST=127.0.0.1
PP_API_PORT=8000

# Comma-separated list of origins allowed to call the API (the dashboard dev server)
PP_CORS_ORIGINS=http://localhost:5173

# MySQL connection URL. Supplied by the project owner once the database exists
# (tasks API-02 and CLD-03). Leave empty while running the skeleton.
PP_DATABASE_URL=
